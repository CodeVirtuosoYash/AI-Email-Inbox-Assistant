# Get a free key at https://aistudio.google.com/apikey (no billing account needed)
GEMINI_API_KEY=

# gemini-2.5-flash is the current free-tier flash model on AI-Studio keys.
# Model availability changes over time — if you get a 404, run:
#   python -c "import google.generativeai as g; g.configure(api_key='YOUR_KEY'); [print(m.name) for m in g.list_models() if 'generateContent' in m.supported_generation_methods]"
GEMINI_MODEL=gemini-2.5-flash

# Batching: real cap in practice is the model's output-token budget (one JSON
# result comes back per email), so both an input-token estimate and a hard
# email-count ceiling are enforced. Tune down if you hit free-tier rate limits.
GEMINI_MAX_INPUT_TOKENS_PER_BATCH=20000
GEMINI_MAX_OUTPUT_TOKENS_PER_BATCH=8192
GEMINI_EST_OUTPUT_TOKENS_PER_EMAIL=220

GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_SECONDS=2

# Defaults to ../data/emails.json relative to this file; override if needed.
EMAIL_FILE=

DATABASE_URL=sqlite:///./inbox_copilot.db
